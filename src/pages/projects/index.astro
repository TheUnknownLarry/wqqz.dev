---
import Base from "../../layouts/Base.astro";
import ArchiveList from "../../components/archives/ArchiveList";
import { getArchivePosts } from "../../lib/archive_data";

const clientPosts = await getArchivePosts();
---
<Base title="Projects" description="Recent updates on my private work">
  <section class="container mx-auto px-6 pt-16 pb-20">
    <div class="max-w-3xl mx-auto mb-8">
      <h1 class="text-4xl font-bold tracking-tight text-foreground">Projects</h1>
      <p class="mt-2 text-base text-muted-foreground leading-relaxed">
        Recent updates on my private work
      </p>
    </div>
    <ArchiveList posts={clientPosts} client:load />
  </section>
</Base>
